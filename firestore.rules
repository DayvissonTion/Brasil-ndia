rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCharacterId(charId) {
      return charId in [
        'ever',
        'silver',
        'anciao',
        'hamaya',
        'enbraim',
        'meyanga',
        'gakumelos',
        'guardiao',
        'elo1000'
      ];
    }

    function isValidGameSave(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.playerName is string &&
             data.playerName.size() >= 1 &&
             data.playerName.size() <= 60 &&
             data.activeCharacterId is string &&
             isValidCharacterId(data.activeCharacterId) &&
             data.keysCollected is int &&
             data.keysCollected >= 0 &&
             data.keysCollected <= 100000 &&
             data.enemiesDefeated is int &&
             data.enemiesDefeated >= 0 &&
             data.enemiesDefeated <= 1000000 &&
             data.mediumEnemiesCycle is int &&
             data.mediumEnemiesCycle >= 0 &&
             data.mediumEnemiesCycle <= 20 &&
             data.currentRealmIndex is int &&
             data.currentRealmIndex >= 0 &&
             data.currentRealmIndex <= 3 &&
             data.bossesDefeated is int &&
             data.bossesDefeated >= 0 &&
             data.bossesDefeated <= 100000 &&
             data.satantiDowns is int &&
             data.satantiDowns >= 0 &&
             data.satantiDowns <= 100000 &&
             data.keyTimerMaxSeconds is int &&
             data.keyTimerMaxSeconds >= 30 &&
             data.keyTimerMaxSeconds <= 3600 &&
             data.finalWarActive is bool &&
             data.secretUnlocked is bool &&
             data.highScore is int &&
             data.highScore >= 0 &&
             data.highScore <= 100000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/game_saves/{saveId} {
      allow get: if isOwner(userId) && isValidId(saveId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(saveId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId',
                         'playerName',
                         'activeCharacterId',
                         'keysCollected',
                         'enemiesDefeated',
                         'mediumEnemiesCycle',
                         'currentRealmIndex',
                         'bossesDefeated',
                         'satantiDowns',
                         'keyTimerMaxSeconds',
                         'finalWarActive',
                         'secretUnlocked',
                         'highScore',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'playerName',
                         'activeCharacterId',
                         'keysCollected',
                         'enemiesDefeated',
                         'mediumEnemiesCycle',
                         'currentRealmIndex',
                         'bossesDefeated',
                         'satantiDowns',
                         'keyTimerMaxSeconds',
                         'finalWarActive',
                         'secretUnlocked',
                         'highScore',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidGameSave(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(saveId) &&
                       isValidGameSave(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'playerName',
                         'activeCharacterId',
                         'keysCollected',
                         'enemiesDefeated',
                         'mediumEnemiesCycle',
                         'currentRealmIndex',
                         'bossesDefeated',
                         'satantiDowns',
                         'keyTimerMaxSeconds',
                         'finalWarActive',
                         'secretUnlocked',
                         'highScore',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(saveId);
    }
  }
}
